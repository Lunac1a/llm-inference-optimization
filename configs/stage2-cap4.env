# Stage 2 inherits the pinned Stage 1 settings. Source this file only from the project scripts.
MODEL_ID="Qwen/Qwen3-4B"
MODEL_REVISION="1cfa9a7208912126459214e8b04321603b3df60c"
MODEL_CACHE_DIR="/home/lunacia/.cache/huggingface"

HOST="127.0.0.1"
PORT="8000"
SERVED_MODEL_NAME="qwen3-4b-baseline"

TENSOR_PARALLEL_SIZE="1"
DTYPE="bfloat16"
MAX_MODEL_LEN="4096"
GPU_MEMORY_UTILIZATION="0.80"
MAX_NUM_SEQS="4"
MAX_NUM_BATCHED_TOKENS="2048"
ENABLE_PREFIX_CACHING="false"
ENABLE_CHUNKED_PREFILL="true"
ENFORCE_EAGER="true"

# WSL compatibility switches required by the pinned vLLM 0.23.0 runtime.
# V1's default V2 model runner requires UVA here; FlashInfer sampling would
# JIT-build with nvcc, which is not installed in the user-managed WSL image.
VLLM_USE_V2_MODEL_RUNNER="0"
VLLM_USE_FLASHINFER_SAMPLER="0"
PYTHON_DEV_HEADERS="$stage1_repo_root/.tmp/python-dev/extracted/usr/include/python3.12"
PYTHON_DEV_INCLUDE_ROOT="$stage1_repo_root/.tmp/python-dev/extracted/usr/include"

BENCH_OUTPUT_LEN="128"
BENCH_NUM_WARMUPS="4"
BENCH_NUM_PROMPTS="32"
BENCH_ROUNDS="3"
BENCH_SEED="42"
